# Dependencies
node_modules/

# Build output
dist/
out/
build/
.vite/
.cache/
.electron-builder/

# Environment files
.env*
!.env.example
.npmrc
*.local
*.local.*
*.user
*.user.*

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# Logs
logs/
*.log
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Electron builder output
release/
*.exe
*.dmg
*.AppImage
*.snap
*.deb
*.rpm

# Temporary files
.scratch/
tmp/
temp/
*.tmp
*.bak
*.backup
scripts/temp-*.js

# Local agent/test artifacts
.claude/settings.local.json
_ref/

# Runtime data (user-specific, not needed for deployment)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Generated machine-local registry exports
*.reg

# ProEng runtime/user-created artifacts belong in data/proeng, not source resources
resources/proeng/sessions/*
!resources/proeng/sessions/.gitignore
resources/proeng/templates/*
!resources/proeng/templates/.gitkeep

# TypeScript cache
*.tsbuildinfo

# Package manager locks (keep one, ignore others based on preference)
# yarn.lock
# pnpm-lock.yaml
